[Desktop Entry]
Type=Application
Name=hDesktop
GenericName=Dock
Comment=OpenGL dock with taskbar, app drawer, tray and workspace switcher
Exec=@BINDIR@/hdesktop
Icon=user-desktop
Terminal=false
Categories=System;
NoDisplay=true
# KWin only hands these protocols to clients whose .desktop file asks for them.
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,org_kde_plasma_virtual_desktop_management
